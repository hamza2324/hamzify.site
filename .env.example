# ---------------------------------------------------------------------------
# Hamzify environment variables
#
# Copy this file to `.env.local` and fill in the values you need.
# Everything here is optional: the site builds and runs with no env file at all.
# Never commit `.env.local` or real secrets.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, canonical URLs, sitemap, RSS and JSON-LD.
# Must include the protocol and must NOT have a trailing slash.
# Defaults to https://hamzify.site when unset.
NEXT_PUBLIC_SITE_URL=https://hamzify.site

# ---------------------------------------------------------------------------
# Analytics (optional). Leave blank to ship zero analytics JavaScript.
# Supported providers: "plausible" | "umami" | "ga"
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible / Umami: the domain or website id registered with the provider.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Self-hosted script URL (Plausible/Umami). Falls back to the provider default.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# Google Analytics measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Newsletter (optional).
# The signup form posts to this endpoint. When empty the form explains that
# signups are not connected yet instead of pretending to succeed.
# Example: a Buttondown/Mailchimp/Resend form action or your own function URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# ---------------------------------------------------------------------------
# Contact form (optional).
# A public form endpoint such as Formspree (https://formspree.io/f/xxxxxxx).
# When empty the contact page shows the email fallback instead of a broken form.
# Do not put private API keys here: NEXT_PUBLIC_* values ship to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# Search Console / Bing verification meta tags (optional).
# Prefer DNS or HTML-file verification when you can; these are here for
# convenience if you choose the meta-tag method.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
